// Vibe Venue - College of Engineering reservable rooms
//
// Overlap safety note: the "no double-booking" guarantee is NOT enforced here.
// Prisma cannot express exclusion constraints, so it lives in the migrations as
// a constraint on booking_spaces:
//
//   EXCLUDE USING gist (space_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&)
//
// It is on the *space* claims rather than on bookings because one physical
// space can be listed more than once - C165a, C165b and the combined C165 are
// three rooms over two halves - and a per-room constraint cannot see across
// listings. Every booking claims one row per space it occupies; the claims are
// deleted when it is cancelled or denied.
//
// This relies on every room mapping to at least one Space. createBooking()
// refuses otherwise, and scripts/verify-overlap.ts asserts it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  MEETING
  CONFERENCE
  ADAPTABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DENIED
}

enum ImageKind {
  PHOTO
  PLAN
}

model Room {
  id     String   @id @default(cuid())
  slug   String   @unique
  number String   @unique
  name   String
  type   RoomType

  building String @default("JAG-Ed Center")
  floor    String @default("B")

  summary     String
  description String?

  /// Seats actually set out in the room — what the room "seats".
  capacity Int
  /// Fire-code / posted maximum, when it differs from the seated count. A
  /// classroom with 18 chairs can still hold 45 standing, and the booking form
  /// checks headcount against this when it is set.
  maxOccupancy Int?
  widthFt      Int?
  lengthFt     Int?

  /// Shown to users but not bookable yet (prototype rollout, or space under renovation).
  isBookable Boolean @default(true)
  /// PENDING -> staff review, instead of instant CONFIRMED.
  needsApproval Boolean @default(false)

  /// Minutes from local midnight. 420 = 7:00 AM, 1200 = 8:00 PM. Times are America/Phoenix.
  openMinute  Int   @default(420)
  closeMinute Int   @default(1200)
  /// Weekdays open, 0 = Sunday .. 6 = Saturday.
  openDays    Int[] @default([1, 2, 3, 4, 5])

  minMinutes  Int @default(30)
  maxMinutes  Int @default(240)
  /// How far ahead a reservation may be made.
  advanceDays Int @default(120)

  /// Key into the interactive floor plan (components/floor-plan/geometry.ts).
  planKey   String?
  sortOrder Int     @default(0)

  amenities Amenity[]
  images    RoomImage[]
  bookings  Booking[]
  closures  Closure[]
  /// The physical space(s) this listing occupies. See the Space model.
  spaces    RoomSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("rooms")
}

model Amenity {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  category String  @default("general")
  rooms    Room[]

  @@map("amenities")
}

model RoomImage {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  kind      ImageKind @default(PHOTO)
  sortOrder Int       @default(0)

  @@index([roomId])
  @@map("room_images")
}

model Booking {
  id     String @id @default(cuid())
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Half-open interval [startsAt, endsAt): a booking ending at 10:00 does not
  /// collide with one starting at 10:00.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  status BookingStatus @default(CONFIRMED)

  title     String
  purpose   String?
  attendees Int     @default(1)

  requesterName  String  @map("requester_name")
  requesterEmail String  @map("requester_email")
  requesterPhone String? @map("requester_phone")
  department     String?

  /// Shown to the requester so they can cancel without an account. Prototype-only;
  /// drop this once SSO lands (see lib/auth.ts).
  manageToken String @unique @default(cuid()) @map("manage_token")

  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?   @map("cancel_reason")
  staffNote     String?   @map("staff_note")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One row per physical space held. These are what actually enforce
  /// no-double-booking; they are deleted when a booking is cancelled or denied.
  spaces BookingSpace[]

  @@index([roomId, startsAt])
  @@index([requesterEmail])
  @@index([status])
  @@map("bookings")
}

/// A physical, indivisible piece of the building.
///
/// A bookable Room is not always a physical room. C165 has a movable partition,
/// so it is listed three ways — C165a, C165b, and the combined space — over two
/// physical halves. Booking any listing holds every space it covers, which is
/// what stops the combined room and a half being booked at the same time.
/// Most rooms are exactly one space and this layer is invisible.
model Space {
  id    String @id @default(cuid())
  key   String @unique
  label String

  rooms    RoomSpace[]
  bookings BookingSpace[]

  @@map("spaces")
}

model RoomSpace {
  roomId  String @map("room_id")
  spaceId String @map("space_id")
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([roomId, spaceId])
  @@index([spaceId])
  @@map("room_spaces")
}

/// A claim on one physical space for one interval. The exclusion constraint on
/// this table is the real no-double-booking guarantee; see the migration.
model BookingSpace {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  @@index([spaceId, startsAt])
  @@index([bookingId])
  @@map("booking_spaces")
}

/// Blackout window — holiday closure, maintenance, a semester-long class block.
/// A closure with no roomId applies to every room.
model Closure {
  id     String  @id @default(cuid())
  roomId String? @map("room_id")
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([roomId, startsAt])
  @@map("closures")
}
