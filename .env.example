# Local dev database (matches docker-compose.yml -> `npm run db:up`)
DATABASE_URL="postgresql://venue:venue@localhost:5455/venue?schema=public"

# On Vercel, set DATABASE_URL to the pooled connection string and
# DIRECT_URL to the direct one (migrations cannot run over a pgbouncer pool).
# DIRECT_URL="postgresql://..."

# Prototype auth shim — see lib/auth.ts. Comma-separated emails get the staff view.
ADMIN_EMAILS="vegaa055@arizona.edu"

# Displayed timezone. Arizona does not observe DST.
NEXT_PUBLIC_TZ="America/Phoenix"

# Uploaded room photos. Create a Blob store in the Vercel dashboard and paste
# its token here. Without it, uploads fall back to writing into public/rooms/,
# which works locally and fails once deployed.
BLOB_READ_WRITE_TOKEN=

# The admin panel refuses to run in production while identity is still a cookie
# anyone can type. Set to 1 only if you deliberately want it live before campus
# sign-in exists.
# ALLOW_INSECURE_ADMIN=1

# --- NetID sign-in -----------------------------------------------------------
# Required by Auth.js to sign session cookies. Generate a fresh one per
# environment with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# UA NetID via Microsoft Entra ID. Request an app registration from UITS, then
# paste the values here. Until all three are set, the app falls back to the
# development sign-in form, which is refused in production.
# The issuer MUST be tenant-specific — the default "common" endpoint would let
# any Microsoft account in the world sign in.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Reservations require a signed-in NetID. Defaults to required if unset, so a
# missing value fails closed rather than opening booking to the internet.
# Set to 0 when the service opens to the public.
REQUIRE_SIGN_IN_TO_BOOK=1
